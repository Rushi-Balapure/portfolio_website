---
import { getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';
import CompanionPlanet from '../components/CompanionPlanet.astro';
import CompanionAstronaut from '../components/CompanionAstronaut.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

// Subtle depth transition: the old page recedes (scale .985 + fade), the new one settles in (1.015 -> 1).
const pair = {
  old: { name: 'vt-depth-out', duration: '0.32s', easing: 'cubic-bezier(0.4, 0, 0.6, 1)', fillMode: 'forwards' },
  new: { name: 'vt-depth-in', duration: '0.4s', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'backwards' },
};
const depth = { forwards: pair, backwards: pair };

const home = await getEntry('pages', 'home');
const profile = home?.data;
const name = profile?.name ?? 'Rushi';
const siteTitle = Astro.props.title ? `${Astro.props.title} | ${name}` : (profile?.seoTitle ?? `${name} | Portfolio`);
const description = Astro.props.description ?? profile?.summary ?? 'Developer portfolio';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(Astro.props.image ?? '/og-image.png', Astro.site);
const addressLocality = profile?.location?.split(',')[0]?.trim();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  url: Astro.site?.href,
  email: profile?.email,
  sameAs: [profile?.githubUrl, profile?.linkedinUrl, profile?.xUrl].filter(Boolean),
  jobTitle: profile?.role,
  homeLocation: addressLocality
    ? {
        '@type': 'Place',
        address: { '@type': 'PostalAddress', addressLocality, addressCountry: 'IN' },
      }
    : undefined,
  worksFor: {
    '@type': 'Organization',
    name: 'ProMobi Technologies',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Pune Institute of Computer Technology',
  },
};
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0d0b0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name}, ${profile?.role ?? 'Product Engineer'}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="alternate" type="application/rss+xml" title={`${name} blogs`} href="/rss.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{siteTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Starfield />
    <CompanionPlanet />
    <CompanionAstronaut />
    <Header name={name} />
    <main id="main-content" transition:name="page-content" transition:animate={depth}><slot /></main>
    <Footer name={name} email={profile?.email} githubUrl={profile?.githubUrl} linkedinUrl={profile?.linkedinUrl} xUrl={profile?.xUrl} />
    <script>
      // Scale origin for the page-depth transition: the viewport centre, in each snapshot's own coordinates.
      const mainEl = () => document.getElementById('main-content');
      const setOrigin = (name: string, scroll: number) => {
        const m = mainEl();
        if (!m) return;
        const top = m.getBoundingClientRect().top + window.scrollY;
        document.documentElement.style.setProperty(name, `${Math.round(window.innerHeight / 2 + scroll - top)}px`);
      };
      document.addEventListener('astro:before-preparation', () => setOrigin('--vt-oy-old', window.scrollY));
      document.addEventListener('astro:after-swap', () => {
        const back = (history.state as { scrollY?: number } | null)?.scrollY;
        setOrigin('--vt-oy-new', typeof back === 'number' ? back : 0);
      });
    </script>
    <script>
      let observer: IntersectionObserver | undefined;
      const reveal = () => {
        observer?.disconnect();
        const items = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          items.forEach((item) => item.classList.add('is-visible'));
          return;
        }
        observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer?.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -5% 0px' });
        items.forEach((item) => {
          const rect = item.getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) item.classList.add('is-visible');
          else observer?.observe(item);
        });
        document.documentElement.classList.add('reveal-ready');
      };
      reveal();
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.remove('reveal-ready');
      });
      document.addEventListener('astro:page-load', reveal);
      document.addEventListener('astro:before-swap', () => observer?.disconnect());
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.65rem 0.9rem;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 0.5rem;
    transform: translateY(-150%);
  }
  .skip-link:focus { transform: none; }
</style>
