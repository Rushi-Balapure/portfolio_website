---
import { getCollection, getEntry } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import CommandMenu, { type CommandItem } from '../components/CommandMenu.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const home = await getEntry('pages', 'home');
const profile = home?.data;
const name = profile?.name ?? 'Rushi';
const siteTitle = Astro.props.title ? `${Astro.props.title} | ${name}` : (profile?.seoTitle ?? `${name} | Portfolio`);
const description = Astro.props.description ?? profile?.summary ?? 'Developer portfolio';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(Astro.props.image ?? '/og-image.png', Astro.site);
const projects = (await getCollection('projects')).filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.priority - a.data.priority);
const commandItems: CommandItem[] = [
  { id: 'jump-top', group: 'Jump to', label: 'Introduction', hint: 'home', href: '/#intro', keywords: 'hero about top start' },
  { id: 'jump-stack', group: 'Jump to', label: 'Tech stack', hint: 'home', href: '/#stack', keywords: 'skills tools languages python' },
  { id: 'jump-experience', group: 'Jump to', label: 'Experience', hint: 'home', href: '/#experience', keywords: 'work career job promobi' },
  { id: 'jump-work', group: 'Jump to', label: 'Selected projects', hint: 'home', href: '/#selected-work', keywords: 'projects work' },
  { id: 'jump-oss', group: 'Jump to', label: 'Open source', hint: 'home', href: '/#open-source', keywords: 'github oss' },
  { id: 'jump-research', group: 'Jump to', label: 'Research', hint: 'home', href: '/#research', keywords: 'papers publications' },
  { id: 'jump-contact', group: 'Jump to', label: 'Contact', hint: 'footer', href: '#contact', keywords: 'email hire talk' },
  { id: 'page-experience', group: 'Pages', label: 'Experience', href: '/experience/', keywords: 'career' },
  { id: 'page-projects', group: 'Pages', label: 'Projects', href: '/projects/', keywords: 'work archive' },
  { id: 'page-oss', group: 'Pages', label: 'Open source', href: '/open-source/', keywords: 'github' },
  { id: 'page-publications', group: 'Pages', label: 'Publications', href: '/publications/', keywords: 'research papers' },
  { id: 'page-community', group: 'Pages', label: 'Community & speaking', href: '/community/', keywords: 'talks workshops' },
  { id: 'page-education', group: 'Pages', label: 'Education', href: '/education/', keywords: 'college university pict' },
  { id: 'page-blogs', group: 'Pages', label: 'Writing', href: '/blogs/', keywords: 'blog posts articles' },
  ...projects.map(({ id, data }) => ({
    id: `project-${id}`,
    group: 'Projects' as const,
    label: data.title,
    hint: data.role,
    href: `/projects/${id}/`,
    keywords: [...data.tags, ...(data.stack ?? [])].join(' '),
  })),
  { id: 'link-resume', group: 'Links', label: 'Resume (PDF)', href: '/resume.pdf', external: true, keywords: 'cv' },
  ...(profile?.githubUrl ? [{ id: 'link-github', group: 'Links' as const, label: 'GitHub', hint: profile.githubUsername, href: profile.githubUrl, external: true, keywords: 'code repositories' }] : []),
  ...(profile?.linkedinUrl ? [{ id: 'link-linkedin', group: 'Links' as const, label: 'LinkedIn', href: profile.linkedinUrl, external: true }] : []),
  ...(profile?.xUrl ? [{ id: 'link-x', group: 'Links' as const, label: 'X / Twitter', href: profile.xUrl, external: true }] : []),
  ...(profile?.email ? [{ id: 'link-email', group: 'Links' as const, label: 'Send an email', hint: profile.email, href: `mailto:${profile.email}`, keywords: 'contact mail' }] : []),
  { id: 'theme-dark', group: 'Theme', label: 'Dark theme', action: 'theme:dark', keywords: 'mode night appearance' },
  { id: 'theme-light', group: 'Theme', label: 'Light theme', action: 'theme:light', keywords: 'mode day appearance' },
  { id: 'theme-system', group: 'Theme', label: 'Match system theme', action: 'theme:system', keywords: 'mode auto appearance' },
];
const pageTransition = {
  forwards: {
    old: { name: 'page-out-forward', duration: '160ms', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
    new: { name: 'page-in-forward', duration: '300ms', delay: '60ms', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'both' },
  },
  backwards: {
    old: { name: 'page-out-back', duration: '160ms', easing: 'cubic-bezier(0.4, 0, 1, 1)', fillMode: 'both' },
    new: { name: 'page-in-back', duration: '300ms', delay: '60ms', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'both' },
  },
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  url: Astro.site?.href,
  email: profile?.email,
  sameAs: [profile?.githubUrl, profile?.linkedinUrl, profile?.xUrl].filter(Boolean),
  jobTitle: profile?.role,
  homeLocation: profile?.location,
  worksFor: {
    '@type': 'Organization',
    name: 'ProMobi Technologies',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Pune Institute of Computer Technology',
  },
};
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <meta name="description" content={description} />
    {Astro.props.noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta id="theme-color" name="theme-color" content="#090b0e" />
    <script is:inline>
      (() => {
        if (window.__portfolioTheme) {
          window.__portfolioTheme.apply(window.__portfolioTheme.read());
          return;
        }
        const key = 'theme-preference';
        const allowed = ['dark', 'light', 'system'];
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const root = document.documentElement;
        let currentPreference = 'dark';

        const readPreference = () => {
          try {
            const saved = localStorage.getItem(key);
            return allowed.includes(saved) ? saved : 'dark';
          } catch {
            return 'dark';
          }
        };

        const applyTheme = (preference, persist = false) => {
          currentPreference = preference;
          const resolved = preference === 'system' ? (media.matches ? 'dark' : 'light') : preference;
          root.dataset.themePreference = preference;
          root.dataset.theme = resolved;
          root.style.colorScheme = resolved;

          const themeColor = document.querySelector('#theme-color');
          if (themeColor) themeColor.setAttribute('content', resolved === 'dark' ? '#090b0e' : '#f3f5f7');

          if (persist) {
            try { localStorage.setItem(key, preference); } catch {}
          }

          window.dispatchEvent(new CustomEvent('themechange', { detail: { preference, resolved } }));
        };

        window.__portfolioTheme = { apply: applyTheme, read: readPreference, media };
        applyTheme(readPreference());
        document.addEventListener('astro:after-swap', () => applyTheme(currentPreference));
      })();
    </script>
    <link rel="preload" href="/fonts/space-grotesk.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-sans.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name}, ${profile?.role ?? 'Product Engineer'}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="alternate" type="application/rss+xml" title={`${name} blogs`} href="/rss.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{siteTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header name={name} />
    <main id="main-content" transition:name="page-content" transition:animate={pageTransition}><slot /></main>
    <Footer name={name} email={profile?.email} githubUrl={profile?.githubUrl} linkedinUrl={profile?.linkedinUrl} xUrl={profile?.xUrl} />
    <CommandMenu items={commandItems} />
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.65rem 0.9rem;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: 0.5rem;
    transform: translateY(-150%);
  }
  .skip-link:focus { transform: none; }
  .toast {
    position: fixed;
    bottom: var(--space-5);
    left: 50%;
    z-index: 60;
    padding: var(--space-3) var(--space-5);
    color: var(--paper);
    background: var(--ink);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    box-shadow: 0 1rem 2rem var(--shadow);
    opacity: 0;
    transform: translate(-50%, 12px);
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-in), transform var(--dur-fast) var(--ease-in);
  }
  .toast.is-visible { opacity: 1; transform: translate(-50%, 0); transition-duration: var(--dur); transition-timing-function: var(--ease); }
</style>
