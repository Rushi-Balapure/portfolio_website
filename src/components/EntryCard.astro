---
interface Props {
  href?: string;
  eyebrow?: string;
  title: string;
  summary: string;
  date?: Date;
  tags?: string[];
  large?: boolean;
}

const { href, eyebrow, title, summary, date, tags = [], large = false } = Astro.props;
const Wrapper = href ? 'a' : 'article';
const dateLabel = date?.toLocaleDateString('en', { month: 'short', year: 'numeric' });
---

<Wrapper class:list={['entry-card', { large }]} href={href} data-reveal>
  <div class="card-top">
    <span>{eyebrow ?? dateLabel ?? 'Selected work'}</span>
    {href && <span aria-hidden="true">→</span>}
  </div>
  <div>
    <h3>{title}</h3>
    <p>{summary}</p>
    {tags.length > 0 && <ul class="pill-list" aria-label="Tags">{tags.slice(0, 4).map((tag) => <li class="pill">{tag}</li>)}</ul>}
  </div>
</Wrapper>

<style>
  .entry-card {
    grid-column: span 6;
    display: flex;
    min-height: 21rem;
    padding: clamp(1.15rem, 2.6vw, 1.6rem);
    flex-direction: column;
    justify-content: space-between;
    color: var(--ink);
    background: var(--elevated);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 0.15rem);
    text-decoration: none;
    box-shadow: var(--material-shadow);
    transition-property: transform, background-color, box-shadow;
    transition-duration: 220ms;
    transition-timing-function: var(--spring);
  }

  .entry-card.large {
    grid-column: span 8;
    min-height: 24rem;
  }

  a.entry-card:hover {
    background: var(--card-hover);
  }

  a.entry-card:active {
    transform: scale(0.985);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 510;
    letter-spacing: 0.01em;
  }

  h3 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
    font-weight: 590;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-wrap: balance;
  }

  p {
    max-width: 36rem;
    margin: 0.75rem 0 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  @media (max-width: 760px) {
    .entry-card,
    .entry-card.large {
      grid-column: 1 / -1;
      min-height: 18rem;
    }
  }
</style>
