---
import ProjectVisual from './ProjectVisual.astro';

interface Props {
  href?: string;
  eyebrow?: string;
  title: string;
  summary: string;
  date?: Date;
  tags?: string[];
  large?: boolean;
  project?: string;
}

const { href, eyebrow, title, summary, date, tags = [], large = false, project } = Astro.props;
const visualProject = project && ['insidia-labs', 'ai-vulnerability-detection', 'arise'].includes(project) ? project : undefined;
const Wrapper = href ? 'a' : 'article';
const dateLabel = date?.toLocaleDateString('en', { month: 'short', year: 'numeric' });
---

<Wrapper class:list={['entry-card', { large, 'has-visual': !!visualProject }]} href={href} data-reveal data-spotlight>
  {visualProject && <ProjectVisual project={visualProject} />}
  <div class="card-content">
  <div class="card-top">
    <span>{eyebrow ?? dateLabel ?? 'Selected work'}</span>
    {href && <span aria-hidden="true">↗</span>}
  </div>
  <div>
    <h3>{title}</h3>
    <p>{summary}</p>
    {tags.length > 0 && <ul class="pill-list" aria-label="Tags">{tags.slice(0, 4).map((tag) => <li class="pill">{tag}</li>)}</ul>}
  </div>
  </div>
</Wrapper>

<style>
  .entry-card {
    grid-column: span 6;
    display: flex;
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 19rem;
    flex-direction: column;
    justify-content: space-between;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 200ms, box-shadow 200ms, background 200ms;
  }
  .entry-card::before { position: absolute; inset: 0; z-index: 1; border-radius: inherit; background: radial-gradient(380px circle at var(--spot-x, 50%) var(--spot-y, 50%), var(--accent-glow), transparent 75%); opacity: 0; content: ''; pointer-events: none; transition: opacity 250ms; }
  .entry-card:hover::before { opacity: 1; }
  .card-content { position: relative; display: flex; flex: 1; flex-direction: column; justify-content: space-between; gap: 2rem; padding: clamp(1.3rem, 3vw, 2rem); }
  .entry-card.large { grid-column: 1 / -1; }
  .entry-card.large.has-visual { display: grid; grid-template-columns: 1.1fr 1fr; }
  .large.has-visual :global(.project-visual) { border-bottom: 0; border-right: 1px solid var(--line); min-height: 21rem; }
  a.entry-card:hover { background: var(--card-hover); border-color: color-mix(in srgb, var(--accent) 40%, var(--line)); box-shadow: 0 1rem 2rem var(--shadow); }
  .card-top { display: flex; align-items: start; justify-content: space-between; gap: 1rem; color: var(--muted); font: 0.6rem var(--font-mono); letter-spacing: 0.07em; text-transform: uppercase; }
  .card-top > span:last-child { flex-shrink: 0; }
  h3 { max-width: 26ch; margin: 0; font-size: clamp(1.3rem, 2vw, 1.8rem); font-weight: 550; letter-spacing: -0.035em; line-height: 1.15; text-wrap: balance; }
  p { max-width: 37rem; margin: 0.85rem 0 0; color: var(--muted); font-size: 0.85rem; line-height: 1.7; text-wrap: pretty; }
  @media (max-width: 760px) {
    .entry-card, .entry-card.large { grid-column: 1 / -1; min-height: 17rem; }
    .entry-card.large.has-visual { display: flex; }
    .large.has-visual :global(.project-visual) { min-height: 16rem; border-right: 0; border-bottom: 1px solid var(--line); }
  }
</style>

<script>
  if (window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty('--spot-x', `${event.clientX - rect.left}px`);
        card.style.setProperty('--spot-y', `${event.clientY - rect.top}px`);
      });
    });
  }
</script>
