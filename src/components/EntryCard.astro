---
interface Props {
  href?: string;
  eyebrow?: string;
  title: string;
  summary: string;
  date?: Date;
  tags?: string[];
  large?: boolean;
}

const { href, eyebrow, title, summary, date, tags = [], large = false } = Astro.props;
const Wrapper = href ? 'a' : 'article';
const dateLabel = date?.toLocaleDateString('en', { month: 'short', year: 'numeric' });
---

<Wrapper class:list={['entry-card', { large }]} href={href} data-reveal>
  <div class="card-top">
    <span>{eyebrow ?? dateLabel ?? 'Selected work'}</span>
    {href && <span aria-hidden="true">↗</span>}
  </div>
  <div>
    <h3>{title}</h3>
    <p>{summary}</p>
    {tags.length > 0 && <ul class="pill-list" aria-label="Tags">{tags.slice(0, 4).map((tag) => <li class="pill">{tag}</li>)}</ul>}
  </div>
</Wrapper>

<style>
  .entry-card {
    grid-column: span 6;
    display: flex;
    min-height: 25rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    flex-direction: column;
    justify-content: space-between;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 450ms var(--ease), box-shadow 450ms var(--ease), background 450ms var(--ease);
  }
  .entry-card.large { grid-column: span 8; min-height: 30rem; }
  a.entry-card:hover { background: var(--card-hover); box-shadow: 0 1.5rem 4rem var(--shadow); transform: translateY(-0.4rem); }
  .card-top { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.75rem; font-weight: 720; letter-spacing: 0.07em; text-transform: uppercase; }
  h3 { max-width: 16ch; margin: 0; font-size: clamp(1.7rem, 3.5vw, 3rem); letter-spacing: -0.045em; line-height: 1.02; }
  p { max-width: 37rem; margin: 1rem 0 0; color: var(--muted); }
  @media (max-width: 760px) {
    .entry-card, .entry-card.large { grid-column: 1 / -1; min-height: 22rem; }
  }
</style>
