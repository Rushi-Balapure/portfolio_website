---
interface Props {
  name: string;
  email?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  xUrl?: string;
}

const { name, email, githubUrl, linkedinUrl, xUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer id="contact" class="footer">
  <div class="shell footer-panel material">
    <div>
      <p class="eyebrow">Start a conversation</p>
      <h2>Have an idea worth exploring?</h2>
    </div>
    <div class="footer-actions">
      {email ? (
        <div class="email-actions">
          <a class="button" href={`mailto:${email}`}>Send an email</a>
          <button class="button button--quiet" type="button" data-copy-email={email}>Copy email</button>
        </div>
      ) : <p>Add an email to <code>home.md</code> to enable direct contact.</p>}
      <div class="socials">
        {githubUrl && <a href={githubUrl} target="_blank" rel="noreferrer">GitHub</a>}
        {linkedinUrl && <a href={linkedinUrl} target="_blank" rel="noreferrer">LinkedIn</a>}
        {xUrl && <a href={xUrl} target="_blank" rel="noreferrer">X</a>}
        <a href="/resume.pdf" target="_blank" rel="noreferrer">Resume</a>
      </div>
    </div>
  </div>
  <div class="shell legal">
    <span>© {year} {name}</span>
    <span>Built with Astro and Markdown.</span>
  </div>
</footer>

<style>
  .footer {
    padding: clamp(3rem, 8vw, 5.5rem) 0 1.75rem;
  }

  .footer-panel {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: end;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: calc(var(--radius) + 0.35rem);
  }

  h2 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .footer-actions {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  .email-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .footer-actions p {
    max-width: 25rem;
    color: var(--muted);
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .socials a {
    color: var(--muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--press), transform var(--press);
  }

  .socials a:hover { color: var(--ink); }
  .socials a:active { transform: scale(0.97); }

  .legal {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.75rem;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  @media (max-width: 760px) {
    .footer-panel { grid-template-columns: 1fr; }
    .legal { align-items: flex-start; flex-direction: column; }
  }
</style>

<script>
  const bindCopyButtons = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';

      button.addEventListener('click', async () => {
        const email = button.dataset.copyEmail;
        if (!email) return;

        try {
          if (!navigator.clipboard || !window.isSecureContext) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(email);
          const originalLabel = button.textContent;
          button.textContent = 'Copied';
          button.setAttribute('aria-live', 'polite');
          window.setTimeout(() => {
            button.textContent = originalLabel;
            button.removeAttribute('aria-live');
          }, 2000);
        } catch {
          button.textContent = email;
        }
      });
    });
  };

  document.addEventListener('astro:page-load', bindCopyButtons);
  if (document.readyState !== 'loading') bindCopyButtons();
  else document.addEventListener('DOMContentLoaded', bindCopyButtons);
</script>
