---
interface Props {
  name: string;
  email?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  xUrl?: string;
}

const { name, email, githubUrl, linkedinUrl, xUrl } = Astro.props;
const year = new Date().getFullYear();
const socials = [
  githubUrl && { label: 'GitHub', href: githubUrl },
  linkedinUrl && { label: 'LinkedIn', href: linkedinUrl },
  xUrl && { label: 'X', href: xUrl },
  { label: 'Resume', href: '/resume.pdf' },
].filter(Boolean) as { label: string; href: string }[];
---

<footer id="contact" class="footer">
  <div class="shell footer-grid">
    <div class="footer-cta" data-reveal>
      <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>Start a conversation</p>
      <h2>Have an idea worth <span class="accent">exploring?</span></h2>
      {email ? (
        <div class="email-row">
          <a class="email-link" href={`mailto:${email}`}>{email}</a>
          <div class="email-actions">
            <a class="button" href={`mailto:${email}`} data-magnetic>Send an email <span class="button-arrow" aria-hidden="true">↗</span></a>
            <button class="button button--quiet" type="button" data-copy-email={email} data-magnetic>Copy address</button>
          </div>
        </div>
      ) : <p class="muted">Add an email to <code>home.md</code> to enable direct contact.</p>}
    </div>
    <nav class="footer-links" aria-label="Elsewhere" data-reveal>
      <p class="eyebrow">Elsewhere</p>
      <ul>
        {socials.map((social) => (
          <li><a href={social.href} target="_blank" rel="noreferrer"><span>{social.label}</span><span class="arrow" aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="shell legal">
    <span>© {year} {name}</span>
    <span>Built with Astro and Markdown · Press <kbd>/</kbd> to search</span>
    <a href="#main-content" class="to-top">Back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  .footer { padding: clamp(5rem, 9vw, 8rem) 0 var(--space-6); background: var(--sunken); border-top: 1px solid var(--line); }
  .footer-grid { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(14rem, 0.6fr); gap: var(--space-8); align-items: end; }
  .pulse { width: 8px; height: 8px; background: var(--accent); border-radius: 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .pulse { animation: pulse 2.4s var(--ease) infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  }
  h2 { max-width: 14ch; margin: 0; font-size: clamp(2.75rem, 7vw, 5.5rem); font-weight: 600; letter-spacing: -0.045em; line-height: 0.98; }
  .accent { color: var(--accent-ink); }
  .email-row { margin-top: var(--space-7); }
  .email-link {
    display: inline-block;
    max-width: 100%;
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: clamp(1rem, 2.4vw, 1.5rem);
    overflow-wrap: anywhere;
    text-decoration-thickness: 1px;
  }
  @media (hover: hover) { .email-link:hover { color: var(--accent-ink); } }
  .email-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-5); }
  .muted { color: var(--muted); }
  .footer-links ul { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .footer-links li { border-bottom: 1px solid var(--line); }
  .footer-links a { display: flex; align-items: center; justify-content: space-between; min-height: 3.25rem; color: var(--ink); font-family: var(--font-display); font-size: var(--text-xl); text-decoration: none; }
  .footer-links .arrow { color: var(--muted); font-size: var(--text-md); transition: transform var(--dur) var(--ease), color var(--dur-fast) ease; }
  @media (hover: hover) {
    .footer-links a:hover { color: var(--accent-ink); }
    .footer-links a:hover .arrow { color: var(--accent-ink); transform: translate(3px, -3px); }
  }
  .legal { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-8); padding-top: var(--space-5); color: var(--muted); border-top: 1px solid var(--line); font: var(--text-xs) var(--font-mono); }
  .to-top { display: inline-flex; align-items: center; gap: var(--space-2); min-height: 44px; color: var(--muted); text-decoration: none; }
  @media (hover: hover) { .to-top:hover { color: var(--accent-ink); } }
  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr; gap: var(--space-7); }
    .legal { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  }
</style>
