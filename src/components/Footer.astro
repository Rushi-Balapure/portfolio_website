---
interface Props {
  name: string;
  email?: string;
  githubUrl?: string;
  linkedinUrl?: string;
  xUrl?: string;
}

const { name, email, githubUrl, linkedinUrl, xUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer id="contact" class="footer">
  <div class="shell footer-grid">
    <div>
      <p class="eyebrow">Start a conversation</p>
      <h2>Have an idea worth exploring?</h2>
    </div>
    <div class="footer-actions">
      {email ? (
        <div class="email-actions">
          <a class="button" href={`mailto:${email}`}>Send an email ↗</a>
          <button class="button button--quiet" type="button" data-copy-email={email}>Copy email</button>
        </div>
      ) : <p>Add an email to <code>home.md</code> to enable direct contact.</p>}
      <div class="socials">
        {githubUrl && <a href={githubUrl} target="_blank" rel="noreferrer">GitHub ↗</a>}
        {linkedinUrl && <a href={linkedinUrl} target="_blank" rel="noreferrer">LinkedIn ↗</a>}
        {xUrl && <a href={xUrl} target="_blank" rel="noreferrer">X ↗</a>}
        <a href="/resume.pdf" target="_blank" rel="noreferrer">Resume ↗</a>
      </div>
    </div>
  </div>
  <div class="shell legal">
    <span>© {year} {name}</span>
    <span>Built with Astro and Markdown.</span>
  </div>
</footer>

<style>
  .footer { padding: clamp(5rem, 10vw, 9rem) 0 2rem; color: var(--footer-text); background: var(--footer-bg); }
  .footer .eyebrow { color: var(--footer-accent); }
  .footer-grid { display: grid; grid-template-columns: 1.3fr 0.7fr; gap: 2rem; align-items: end; }
  h2 { max-width: 10ch; margin: 0; font-size: clamp(3rem, 7vw, 7rem); letter-spacing: -0.07em; line-height: 0.95; }
  .footer-actions { display: grid; justify-items: start; gap: 1.5rem; }
  .email-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .footer-actions .button { color: var(--footer-button-text); background: var(--footer-button-bg); border-color: var(--footer-button-bg); }
  .footer-actions .button:hover { color: var(--on-accent); background: var(--accent); border-color: var(--accent); }
  .footer-actions .button--quiet { color: var(--footer-text); background: transparent; border-color: var(--footer-line); cursor: pointer; }
  .footer-actions p { max-width: 25rem; color: var(--footer-muted); }
  .socials { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  .socials a { color: var(--footer-link); font-size: 0.9rem; }
  .legal { display: flex; justify-content: space-between; gap: 1rem; padding-top: 5rem; margin-top: 5rem; color: var(--footer-muted); border-top: 1px solid var(--footer-line); font-size: 0.78rem; }
  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr; }
    .footer-actions { margin-top: 2rem; }
    .legal { align-items: flex-start; flex-direction: column; margin-top: 3rem; padding-top: 2rem; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-copy-email]').forEach((button) => {
      button.addEventListener('click', async () => {
        const email = button.dataset.copyEmail;
        if (!email) return;

        try {
          if (!navigator.clipboard || !window.isSecureContext) throw new Error('Clipboard unavailable');
          await navigator.clipboard.writeText(email);

          const originalLabel = button.textContent;
          button.textContent = 'Copied';
          button.setAttribute('aria-live', 'polite');
          window.setTimeout(() => {
            button.textContent = originalLabel;
            button.removeAttribute('aria-live');
          }, 2000);
        } catch {
          button.textContent = email;
        }
      });
    });
  });
</script>
