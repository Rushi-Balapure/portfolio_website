---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  name: string;
}

const { name } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/experience/', label: 'Experience', spy: 'experience' },
  { href: '/projects/', label: 'Projects', spy: 'selected-work' },
  { href: '/open-source/', label: 'Open Source', spy: 'open-source' },
  { href: '/publications/', label: 'Research', spy: 'research' },
  { href: '/community/', label: 'Community', spy: 'community' },
];
const initials = name.split(' ').map((part) => part[0]?.toLowerCase()).join('').slice(0, 2);
---

<header class="site-header" data-site-header transition:name="site-header" transition:animate="none">
  <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
  <div class="header-inner shell">
    <a class="brand" href="/" aria-label={`${name}, home`}>
      <span class="brand-mark" aria-hidden="true">{initials}<i></i></span>
      <span class="brand-name">{name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {links.map((link) => (
        <a href={link.href} data-spy={link.spy} aria-current={path.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
      <a href="/resume.pdf" target="_blank" rel="noreferrer">Resume <span aria-hidden="true">↗</span></a>
    </nav>

    <button type="button" class="search-trigger" data-command-open aria-haspopup="dialog" aria-controls="command-menu" aria-keyshortcuts="Control+K Meta+K">
      <span class="search-label">Search</span>
      <kbd class="search-kbd" data-command-kbd>Ctrl K</kbd>
    </button>

    <ThemeToggle />

    <button type="button" class="menu-trigger" data-drawer-open aria-haspopup="dialog" aria-controls="mobile-drawer" aria-label="Open navigation">
      <span></span><span></span>
    </button>
  </div>
</header>

<dialog class="drawer" id="mobile-drawer" aria-label="Navigation" data-drawer>
  <div class="drawer-panel">
    <div class="drawer-top">
      <p class="eyebrow">Navigate</p>
      <button type="button" class="drawer-close" data-drawer-close aria-label="Close navigation">
        <svg class="od-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <nav aria-label="Mobile">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}><span class="drawer-index">00</span>Home</a>
      {links.map((link, index) => (
        <a href={link.href} aria-current={path.startsWith(link.href) ? 'page' : undefined} style={`--i:${index + 1}`}>
          <span class="drawer-index">{String(index + 1).padStart(2, '0')}</span>{link.label}
        </a>
      ))}
      <a href="/education/" aria-current={path.startsWith('/education/') ? 'page' : undefined} style={`--i:${links.length + 1}`}><span class="drawer-index">{String(links.length + 1).padStart(2, '0')}</span>Education</a>
    </nav>
    <div class="drawer-foot">
      <a class="button" href="/resume.pdf" target="_blank" rel="noreferrer">Resume <span class="button-arrow" aria-hidden="true">↗</span></a>
      <button type="button" class="button button--quiet" data-command-open data-drawer-close>Search</button>
    </div>
  </div>
</dialog>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--header-height);
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur) ease, background-color var(--dur) ease;
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); background: var(--surface); }

  .scroll-progress { position: absolute; inset: auto 0 -1px 0; height: 2px; pointer-events: none; }
  .scroll-progress span { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; }

  .header-inner { display: flex; align-items: center; height: 100%; gap: var(--space-4); }

  .brand { display: inline-flex; align-items: center; gap: var(--space-3); margin-right: auto; min-height: 44px; text-decoration: none; }
  .brand-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--on-accent);
    background: var(--accent);
    border-radius: var(--radius-sm);
    font: 700 0.95rem var(--font-mono);
    letter-spacing: -0.04em;
    transition: transform var(--dur) var(--ease);
  }
  .brand-mark i { position: absolute; right: -3px; bottom: -3px; width: 8px; height: 8px; background: var(--ink); border: 2px solid var(--paper); border-radius: 50%; }
  .is-scrolled .brand-mark { transform: scale(0.9); }
  .brand-name { font-family: var(--font-display); font-size: var(--text-md); font-weight: 600; letter-spacing: -0.02em; white-space: nowrap; }
  @media (hover: hover) { .brand:hover .brand-mark { transform: rotate(-6deg); } }

  .desktop-nav { display: flex; align-items: center; gap: var(--space-1); }
  .desktop-nav a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }
  .desktop-nav a span { margin-left: 3px; font-size: var(--text-xs); }
  .desktop-nav a::after {
    position: absolute;
    right: var(--space-3);
    bottom: 8px;
    left: var(--space-3);
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform var(--dur) var(--ease);
    content: '';
  }
  @media (hover: hover) { .desktop-nav a:hover { color: var(--ink); } }
  .desktop-nav a[aria-current='page'],
  .desktop-nav a.is-active { color: var(--ink); }
  .desktop-nav a[aria-current='page']::after,
  .desktop-nav a.is-active::after { transform: scaleX(1); }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: 0 var(--space-2) 0 var(--space-3);
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  @media (hover: hover) { .search-trigger:hover { color: var(--ink); border-color: var(--line-strong); } }
  .search-kbd { white-space: nowrap; }

  .menu-trigger {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    place-content: center;
    gap: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }
  .menu-trigger span { display: block; width: 1.1rem; height: 1.5px; background: var(--ink); }
  .menu-trigger span:last-child { width: 0.7rem; justify-self: end; }

  /* Drawer */
  .drawer {
    width: min(22rem, 88vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 0;
    color: var(--ink);
    background: transparent;
    border: 0;
  }
  .drawer::backdrop { background: var(--scrim); }
  .drawer-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-5);
    background: var(--surface);
    border-left: 1px solid var(--line-strong);
    overflow-y: auto;
  }
  .drawer[open] .drawer-panel { animation: drawer-in 320ms var(--ease) both; }
  .drawer[open]::backdrop { animation: fade-in 240ms ease-out both; }
  .drawer.is-closing .drawer-panel { animation: drawer-out 200ms var(--ease-in) both; }
  .drawer.is-closing::backdrop { animation: fade-out 200ms ease-in both; }
  .drawer[open] nav a { animation: item-in 320ms var(--ease) both; animation-delay: calc(80ms + var(--i, 0) * 40ms); }
  @keyframes drawer-in { from { transform: translateX(100%); } }
  @keyframes drawer-out { to { transform: translateX(100%); } }
  @keyframes item-in { from { opacity: 0; transform: translateX(16px); } }
  @keyframes fade-in { from { opacity: 0; } }
  @keyframes fade-out { to { opacity: 0; } }

  .drawer-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-5); }
  .drawer-top .eyebrow { margin: 0; }
  .drawer-close { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: 0; background: transparent; border: 1px solid var(--line); border-radius: var(--radius-sm); --od-icon-size: 1.1rem; }
  .drawer nav { display: grid; }
  .drawer nav a {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .drawer nav a[aria-current='page'] { color: var(--accent-ink); }
  .drawer-index { color: var(--muted); font: var(--text-xs) var(--font-mono); }
  .drawer-foot { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: auto; padding-top: var(--space-6); }

  .od-icon { display: block; width: var(--od-icon-size, 1em); height: var(--od-icon-size, 1em); flex-shrink: 0; }

  @media (max-width: 1060px) {
    .desktop-nav { display: none; }
    .menu-trigger { display: grid; }
  }
  @media (max-width: 640px) {
    .search-label { display: none; }
    .search-trigger { padding: 0 var(--space-2); }
    .header-inner { gap: var(--space-2); }
  }
  @media (max-width: 420px) {
    .brand-name { display: none; }
  }
</style>
