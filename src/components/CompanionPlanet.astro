<div class="planet" data-planet aria-hidden="true" transition:persist>
  <canvas></canvas>
</div>

<style is:global>
  /* Behind content (z -1, after the noise layer), above the starfield (z -2). */
  .planet { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .planet canvas { position: absolute; top: 0; left: 0; display: block; width: 0; height: 0; transform-origin: 50% 50%; will-change: transform, opacity; }
  /* CSS sphere: shown until WebGL is ready, and whenever WebGL is unavailable or lost. */
  .planet::before {
    position: absolute; top: 22vh; right: -3vw; width: 16vw; aspect-ratio: 1; border-radius: 50%; content: '';
    background:
      radial-gradient(circle at 30% 26%, #3f6f73 0%, #1b4150 34%, #0a1c27 62%, #04080d 86%);
    box-shadow: inset -0.4vw -0.2vw 1.2vw rgba(127, 209, 174, 0.14), 0 0 0.5vw rgba(127, 209, 174, 0.08);
    opacity: 0.9;
  }
  .planet.pl-ready:not(.pl-fallback)::before { display: none; }
  .planet.pl-fallback canvas { display: none; }
  @media (max-width: 759px) {
    .planet::before { top: 9vh; right: -8vw; width: 38vw; opacity: 0.5; }
  }
</style>

<script>
  import '../scripts/planet';
</script>
