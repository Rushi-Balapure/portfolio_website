<div class="theme-toggle" role="group" aria-label="Color theme" data-theme-control>
  <button type="button" data-theme-option="dark" aria-label="Dark theme" title="Dark" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" /></svg>
  </button>
  <button type="button" data-theme-option="light" aria-label="Light theme" title="Light" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  </button>
  <button type="button" data-theme-option="system" aria-label="Use system theme" title="System" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
  </button>
</div>

<style>
  .theme-toggle {
    display: inline-flex;
    flex: 0 0 auto;
    padding: 0.15rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 9px;
  }

  button {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    place-items: center;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms var(--ease);
  }
  button:active { transform: scale(0.94); }

  svg {
    display: block;
    width: 0.9rem;
    height: 0.9rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  button[aria-pressed='true'] {
    color: var(--on-accent);
    background: var(--accent);
  }

</style>

<script is:inline>
  (() => {
    const theme = window.__portfolioTheme;
    if (!theme || theme.controlsInitialized) return;
    theme.controlsInitialized = true;
    let activeTransition;
    let changeId = 0;

    const syncControls = (preference) => {
      document.querySelectorAll('[data-theme-option]').forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.themeOption === preference));
      });
    };

    const selectTheme = (preference) => {
      if (preference === document.documentElement.dataset.themePreference && !activeTransition) return;
      const requestId = ++changeId;
      activeTransition?.skipTransition();
      if (!document.startViewTransition || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        activeTransition = undefined;
        delete document.documentElement.dataset.themeTransition;
        theme.apply(preference, true);
        return;
      }
      document.documentElement.dataset.themeTransition = '';
      const transition = document.startViewTransition(() => {
        if (requestId === changeId) theme.apply(preference, true);
      });
      activeTransition = transition;
      transition.finished.then(() => {
        if (activeTransition !== transition) return;
        delete document.documentElement.dataset.themeTransition;
        activeTransition = undefined;
      });
    };

    const initControls = () => {
      document.querySelectorAll('[data-theme-option]').forEach((button) => {
        if (button.dataset.themeBound) return;
        button.dataset.themeBound = 'true';
        button.addEventListener('click', () => selectTheme(button.dataset.themeOption));
      });
      syncControls(document.documentElement.dataset.themePreference || theme.read());
    };

    theme.media.addEventListener('change', () => {
      if (document.documentElement.dataset.themePreference === 'system') theme.apply('system');
    });

    window.addEventListener('storage', (event) => {
      if (event.key === 'theme-preference') theme.apply(theme.read());
    });

    window.addEventListener('themechange', (event) => syncControls(event.detail.preference));
    document.addEventListener('astro:page-load', initControls);
    initControls();
  })();
</script>
