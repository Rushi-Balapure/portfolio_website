<div class="theme-toggle material" role="group" aria-label="Color theme" data-theme-control>
  <button type="button" data-theme-option="dark" aria-label="Dark theme" title="Dark" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z" /></svg>
  </button>
  <button type="button" data-theme-option="light" aria-label="Light theme" title="Light" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  </button>
  <button type="button" data-theme-option="system" aria-label="Use system theme" title="System" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
  </button>
</div>

<style>
  .theme-toggle {
    display: inline-flex;
    flex: 0 0 auto;
    padding: 0.2rem;
    border-radius: 999px;
  }

  button {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    place-items: center;
    color: var(--muted);
    background: transparent;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    transition-property: transform, background-color, color;
    transition-duration: var(--press);
  }

  button:hover { color: var(--ink); }
  button:active { transform: scale(0.96); }

  svg {
    display: block;
    width: 1.05rem;
    height: 1.05rem;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  button[aria-pressed='true'] {
    color: var(--ink);
    background: var(--elevated);
    box-shadow: 0 1px 0 var(--material-highlight) inset;
  }
</style>

<script>
  const syncControls = (preference: string) => {
    document.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeOption === preference));
    });
  };

  const bindThemeControls = () => {
    const theme = window.__portfolioTheme;
    if (!theme) return;

    document.querySelectorAll<HTMLButtonElement>('[data-theme-option]').forEach((button) => {
      if (button.dataset.bound === 'true') return;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const preference = button.dataset.themeOption;
        if (!preference) return;
        theme.apply(preference, true);
      });
    });

    syncControls(document.documentElement.dataset.themePreference || 'system');
  };

  document.addEventListener('astro:page-load', bindThemeControls);
  if (document.readyState !== 'loading') bindThemeControls();
  else document.addEventListener('DOMContentLoaded', bindThemeControls);

  window.addEventListener('themechange', ((event: CustomEvent<{ preference: string }>) => {
    syncControls(event.detail.preference);
  }) as EventListener);

  const theme = window.__portfolioTheme;
  theme?.media.addEventListener('change', () => {
    if (document.documentElement.dataset.themePreference === 'system') theme.apply('system');
  });

  window.addEventListener('storage', (event) => {
    if (event.key === 'theme-preference') window.__portfolioTheme?.apply(window.__portfolioTheme.read());
  });
</script>
