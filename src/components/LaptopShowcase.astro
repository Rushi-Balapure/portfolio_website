---
// Visual direction: Aceternity Macbook Scroll.
// Native Astro/CSS implementation; see COMPONENT_SOURCES.md.
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
const profile = (await getEntry('pages', 'home'))?.data;
const rows = [14, 14, 13, 12];
---

<div class="laptop-showcase" data-reveal>
  <div class="stage-grid" aria-hidden="true"></div>
  <div class="stage-label"><span class="status-dot"></span> A window into my world</div>
  <div class="laptop" aria-label="A personal workspace introducing Rushi Balapure">
    <div class="lid">
      <div class="camera" aria-hidden="true"></div>
      <div class="screen">
        <div class="window-bar">
          <span class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>rushi.workspace</span>
          <span class="window-icon" aria-hidden="true">⌘</span>
        </div>
        <div class="personal-desktop">
          <div class="desktop-heading"><span>HELLO, WORLD.</span><span>PUNE, IN ↗</span></div>
          <div class="desktop-profile">
            <div class="desktop-portrait">{profile?.cover && <Image src={profile.cover} alt="Rushi Balapure" width={240} height={300} loading="eager" fetchpriority="high" />}</div>
            <div class="desktop-intro"><span class="hello">Hey, I'm</span><strong>Rushi<span class="name-dot">.</span></strong><span class="desktop-role">Product engineer.<br/>Always a builder.</span></div>
          </div>
          <div class="desktop-notes"><span><i aria-hidden="true">↳</i> Security & applied AI</span><span><i aria-hidden="true">↳</i> Learning by building</span></div>
          <div class="desktop-footer"><span>STAY CURIOUS.</span><span>KEEP MAKING. ✳</span></div>
        </div>
      </div>
      <div class="lid-label" aria-hidden="true">Built with curiosity.</div>
    </div>
    <div class="keyboard-deck" aria-hidden="true">
      <div class="keyboard">{rows.map((keys) => <div class="key-row">{Array.from({ length: keys }, () => <i></i>)}</div>)}</div>
      <div class="trackpad"></div>
    </div>
    <div class="laptop-base" aria-hidden="true"><span></span></div>
  </div>
  <a class="build-caption" href="#contact">
    <div><span class="caption-index">ENGINEER / EXPLORER / BUILDER</span><strong>Let's make something worthwhile.</strong></div>
    <span class="caption-arrow" aria-hidden="true">↗</span>
  </a>
</div>

<style>
  .laptop-showcase { position: relative; min-width: 0; padding: 2rem 0 0; isolation: isolate; }
  .stage-grid { position: absolute; inset: -4rem -1rem 3rem; z-index: -1; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse, black, transparent 68%); opacity: 0.5; }
  .stage-label { display: flex; align-items: center; gap: 0.55rem; width: fit-content; margin: 0 0 2rem 9%; color: var(--muted); font-size: 0.75rem; }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px color-mix(in srgb, var(--green) 10%, transparent); }
  .laptop { width: 100%; padding-inline: 1%; perspective: 1400px; transform: rotate(-3deg); }
  .lid { position: relative; width: 88%; margin: 0 auto; padding: 3% 2% 0; background: linear-gradient(135deg, #4f535a, #202227 30%, #454950); border: 1px solid #757a82; border-radius: 16px 16px 3px 3px; box-shadow: 0 24px 60px #0004, inset 0 0 0 3px #15171b; transform-origin: bottom; }
  .camera { position: absolute; top: 1.7%; left: calc(50% - 2px); width: 4px; height: 4px; background: #090c10; border: 1px solid #515764; border-radius: 50%; }
  .screen { overflow: hidden; aspect-ratio: 1.55; color: #262a2d; background: #e9e6de; border: 1px solid #060709; border-radius: 5px; }
  .window-bar { display: flex; align-items: center; justify-content: space-between; padding: 2.4% 3.5%; color: #9ca3af; background: #202328; border-bottom: 1px solid #ffffff0d; font: 0.6rem var(--font-mono); }
  .traffic-lights { display: flex; gap: 4px; }
  .traffic-lights i { width: 5px; height: 5px; border-radius: 50%; background: #fd6257; }
  .traffic-lights i:nth-child(2) { background: #f5be4f; }
  .traffic-lights i:nth-child(3) { background: #35c86a; }
  .personal-desktop { padding: 4% 6% 3%; }
  .desktop-heading, .desktop-footer { display: flex; justify-content: space-between; color: #61645f; font: 0.44rem var(--font-mono); letter-spacing: 0.07em; }
  .desktop-profile { display: grid; grid-template-columns: 0.85fr 1.15fr; align-items: center; gap: 7%; margin-top: 5%; }
  .desktop-portrait { overflow: hidden; aspect-ratio: 1; border-radius: 50% 50% 5% 5%; background: #c8c5ba; border: 1px solid #00000015; }
  .desktop-portrait :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 42%; }
  .hello { display: block; font-size: clamp(0.55rem, 1vw, 0.75rem); }
  .desktop-intro strong { display: block; font-size: clamp(1.5rem, 3.6vw, 3.1rem); font-weight: 550; letter-spacing: -0.06em; line-height: 1.2; }
  .name-dot { color: #a24c20; }
  .desktop-role { display: block; margin-top: 0.3rem; font-size: clamp(0.45rem, 0.95vw, 0.7rem); line-height: 1.5; color: #5c605c; }
  .desktop-notes { display: flex; gap: 1rem; margin-top: 5%; font-size: clamp(0.35rem, 0.75vw, 0.55rem); }
  .desktop-notes i { color: #a24c20; font-style: normal; }
  .desktop-footer { margin-top: 5%; padding-top: 3%; border-top: 1px solid #0000001c; }
  .lid-label { padding: 1.8% 0; color: #a9acb1; font-size: 0.38rem; text-align: center; letter-spacing: 0.1em; }
  .keyboard-deck { position: relative; width: 100%; height: 4.6rem; padding: 0.45rem 14% 0; background: linear-gradient(165deg, #747880, #3c4048 40%, #686d75); border: 1px solid #8d9198; border-radius: 2px 2px 8px 8px; transform: rotateX(48deg); transform-origin: top; margin-bottom: -1.45rem; }
  .keyboard { display: grid; gap: 2px; padding: 3px; background: #292c31; border-radius: 3px; }
  .key-row { display: flex; gap: 2px; height: 5px; }
  .key-row i { flex: 1; border-radius: 1px; background: #111317; box-shadow: 0 1px #a2a5aa45; }
  .trackpad { width: 26%; height: 1.5rem; margin: 0.25rem auto; border: 1px solid #30343c; border-radius: 3px; }
  .laptop-base { position: relative; height: 7px; background: linear-gradient(#a1a5ac, #494d55); border-radius: 0 0 45% 45%; box-shadow: 0 15px 24px #0005; }
  .laptop-base span { position: absolute; top: 0; left: 41%; width: 18%; height: 3px; background: #30343b; border-radius: 0 0 8px 8px; }
  .build-caption { display: flex; align-items: center; justify-content: space-between; margin: 3rem 8% 0; padding-top: 1rem; border-top: 1px solid var(--line); text-decoration: none; }
  .caption-index { display: block; color: var(--muted); font: 0.58rem var(--font-mono); letter-spacing: 0.08em; }
  .build-caption strong { display: block; margin-top: 0.3rem; font-size: 0.9rem; font-weight: 500; }
  .caption-arrow { display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border: 1px solid var(--line); border-radius: 50%; transition: background 200ms, color 200ms; }
  .build-caption:hover .caption-arrow { color: var(--on-accent); background: var(--accent); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .lid { animation: open-lid linear both; animation-timeline: view(); animation-range: entry 0% entry 100%; }
      @keyframes open-lid { from { transform: rotateX(-18deg); } to { transform: rotateX(0); } }
    }
  }
  @media (max-width: 900px) {
    .laptop-showcase { width: min(100%, 38rem); margin-inline: auto; }
    .desktop-intro strong { font-size: clamp(2rem, 8vw, 3.5rem); }
    .desktop-role { font-size: clamp(0.5rem, 1.9vw, 0.75rem); }
    .hello { font-size: clamp(0.6rem, 2vw, 0.8rem); }
    .desktop-notes { font-size: clamp(0.4rem, 1.5vw, 0.6rem); }
  }
  @media (max-width: 480px) {
    .desktop-heading, .desktop-footer { font-size: 0.32rem; }
    .desktop-notes { gap: 0.5rem; }
    .window-bar { font-size: 0.45rem; }
    .keyboard-deck { height: 3.6rem; margin-bottom: -1.1rem; }
    .key-row { height: 3px; }
    .trackpad { height: 1rem; }
    .build-caption { margin-top: 2rem; }
  }
</style>
