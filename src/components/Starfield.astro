<div class="starfield" data-starfield aria-hidden="true" transition:persist>
  <canvas></canvas>
</div>

<style is:global>
  .starfield { position: fixed; inset: 0; z-index: -2; overflow: hidden; pointer-events: none; }
  .starfield canvas { display: block; width: 100%; height: 100%; }
  /* Static fallback when WebGL is unavailable or the context is lost. */
  .starfield.sf-fallback {
    background:
      radial-gradient(ellipse 60rem 40rem at 85% 5%, color-mix(in srgb, var(--secondary) 12%, transparent), transparent 70%),
      radial-gradient(ellipse 50rem 40rem at 5% 50%, var(--accent-glow), transparent 70%);
  }
  .starfield.sf-fallback canvas { display: none; }
  .starfield.sf-fallback::before {
    position: absolute; top: 0; left: 0; width: 1px; height: 1px; border-radius: 50%; content: '';
    background: transparent;
    box-shadow:
      7vw 12vh 0 0 color-mix(in srgb, var(--ink) 55%, transparent), 19vw 71vh 0 0 color-mix(in srgb, var(--ink) 4%, transparent), 28vw 34vh 0 0 color-mix(in srgb, var(--link) 5%, transparent),
      41vw 88vh 0 0 color-mix(in srgb, var(--ink) 45%, transparent), 53vw 18vh 0 0 color-mix(in srgb, var(--ink) 6%, transparent), 64vw 52vh 0 0 color-mix(in srgb, var(--link) 4%, transparent),
      77vw 79vh 0 0 color-mix(in srgb, var(--ink) 5%, transparent), 88vw 27vh 0 0 color-mix(in srgb, var(--ink) 6%, transparent), 94vw 63vh 0 0 color-mix(in srgb, var(--link) 45%, transparent),
      12vw 46vh 0 0 color-mix(in srgb, var(--ink) 35%, transparent), 36vw 6vh 0 0 color-mix(in srgb, var(--ink) 5%, transparent), 71vw 94vh 0 0 color-mix(in srgb, var(--ink) 4%, transparent);
