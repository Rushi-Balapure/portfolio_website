---
import activity from '../data/github-contributions.json';

interface Props {
  username?: string;
  profileUrl?: string;
}

const { username = activity.username ?? undefined, profileUrl } = Astro.props;
const emptyWeeks = Array.from({ length: 52 }, () => ({
  days: Array.from({ length: 7 }, () => ({ date: '', count: 0, level: 0 })),
}));
const weeks = activity.weeks.length ? activity.weeks : emptyWeeks;
const updated = activity.updatedAt
  ? new Date(activity.updatedAt).toLocaleDateString('en', { month: 'short', day: 'numeric', year: 'numeric' })
  : undefined;
---

<div class="activity material" data-reveal>
  <div class="activity-top">
    <div>
      <p class="eyebrow">GitHub pulse</p>
      <h3>{activity.weeks.length ? `${activity.totalContributions.toLocaleString()} contributions` : 'Contribution activity'}</h3>
    </div>
    {profileUrl && <a href={profileUrl} target="_blank" rel="noreferrer">@{username ?? 'GitHub'}</a>}
  </div>

  <div class="calendar-scroll" tabindex="0" aria-label="GitHub contribution calendar">
    <div class="calendar" aria-hidden="true">
      {weeks.flatMap((week) => week.days).map((day) => (
        <span class={`level-${day.level}`} title={day.date ? `${day.count} contributions on ${day.date}` : 'No activity data'}></span>
      ))}
    </div>
  </div>

  <div class="activity-bottom">
    <p>
      {activity.weeks.length
        ? `Public activity over the last year${updated ? ` · refreshed ${updated}` : ''}.`
        : 'Add githubUsername and githubUrl to home.md, then set the GITHUB_USERNAME repository variable to load public activity.'}
    </p>
    <div class="legend" aria-label="Contribution intensity from less to more">
      <span>Less</span><i class="level-0"></i><i class="level-1"></i><i class="level-2"></i><i class="level-3"></i><i class="level-4"></i><span>More</span>
    </div>
  </div>
</div>

<style>
  .activity {
    padding: clamp(1.25rem, 3vw, 1.85rem);
    overflow: hidden;
    border-radius: calc(var(--radius) + 0.15rem);
  }

  .activity-top,
  .activity-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
  }

  h3 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    font-variant-numeric: tabular-nums;
  }

  a {
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 590;
    text-decoration: none;
  }

  .calendar-scroll {
    margin-block: 1.75rem;
    padding-bottom: 0.35rem;
    overflow-x: auto;
  }

  .calendar {
    display: grid;
    grid-template-rows: repeat(7, 0.68rem);
    grid-auto-flow: column;
    grid-auto-columns: 0.68rem;
    gap: 0.22rem;
    width: max-content;
    min-width: 100%;
    justify-content: space-between;
  }

  .calendar span,
  .legend i {
    display: block;
    width: 0.68rem;
    height: 0.68rem;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: 0.16rem;
  }

  .calendar .level-1,
  .legend .level-1 { background: color-mix(in srgb, var(--accent) 28%, var(--elevated)); }
  .calendar .level-2,
  .legend .level-2 { background: color-mix(in srgb, var(--accent) 48%, var(--elevated)); }
  .calendar .level-3,
  .legend .level-3 { background: color-mix(in srgb, var(--accent) 72%, var(--elevated)); }
  .calendar .level-4,
  .legend .level-4 { background: var(--accent); }

  .activity-bottom {
    align-items: center;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .activity-bottom p { margin: 0; }

  .legend {
    display: flex;
    align-items: center;
    gap: 0.22rem;
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .activity-top,
    .activity-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .calendar { justify-content: start; }
  }
</style>
