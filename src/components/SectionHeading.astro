---
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, href, linkLabel = 'View all' } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  {href && (
    <div class="aside">
      <a href={href}>{linkLabel} <span aria-hidden="true">↗</span></a>
    </div>
  )}
</header>

<style>
  .section-heading { display: flex; justify-content: space-between; gap: 2rem; align-items: end; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .eyebrow { margin-bottom: 0.7rem; }
  h2 { max-width: 24ch; margin: 0; font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 500; letter-spacing: -0.045em; line-height: 1.1; text-wrap: balance; }
  .aside { flex-shrink: 0; }
  .aside a { display: inline-flex; align-items: center; gap: 1rem; min-height: 44px; color: var(--muted); font-size: 0.75rem; text-decoration: none; }
  .aside a:hover { color: var(--accent); }
  @media (max-width: 700px) {
    .section-heading { align-items: start; gap: 1rem; flex-direction: column; }
  }
</style>
