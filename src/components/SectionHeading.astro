---
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, href, linkLabel = 'View all' } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  {href && (
    <div class="aside">
      <a href={href}>{linkLabel} <span aria-hidden="true">↗</span></a>
    </div>
  )}
</header>

<style>
  .section-heading { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  h2 { max-width: 12ch; margin: 0; font-size: clamp(2.6rem, 5vw, 5rem); font-weight: 620; letter-spacing: -0.06em; line-height: 0.98; }
  .aside { max-width: 29rem; justify-self: center; text-align: center; }
  .aside a { color: var(--accent); font-size: 0.88rem; font-weight: 750; }
  @media (max-width: 700px) {
    .section-heading { grid-template-columns: 1fr; }
    .aside { justify-self: center; }
  }
</style>
