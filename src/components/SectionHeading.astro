---
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, href, linkLabel = 'View all' } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  {href && (
    <a href={href}>{linkLabel}</a>
  )}
</header>

<style>
  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
  }

  a {
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 590;
    text-decoration: none;
    transition: transform var(--press);
  }

  a:active { transform: scale(0.97); }

  @media (max-width: 700px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
