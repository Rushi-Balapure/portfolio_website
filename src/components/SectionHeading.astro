---
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
  index?: string;
}

const { eyebrow, title, href, linkLabel = 'View all', index } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div class="heading-main">
    {index && <span class="heading-index" aria-hidden="true">{index}</span>}
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
    </div>
  </div>
  {href && <a class="text-link aside" href={href}>{linkLabel} <span class="button-arrow" aria-hidden="true">↗</span></a>}
</header>

<style>
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: var(--space-6); margin-bottom: clamp(2rem, 4vw, 3.5rem); }
  .heading-main { display: flex; align-items: start; gap: var(--space-5); min-width: 0; }
  .heading-index { flex-shrink: 0; padding-top: 0.35rem; color: var(--muted); font: 500 var(--text-sm) var(--font-mono); }
  .eyebrow { margin-bottom: var(--space-3); }
  h2 { max-width: 22ch; margin: 0; font-size: var(--text-3xl); font-weight: 600; letter-spacing: -0.035em; line-height: 1.05; }
  .aside { flex-shrink: 0; }
  @media (max-width: 700px) {
    .section-heading { flex-direction: column; align-items: start; gap: var(--space-3); }
    .heading-main { gap: var(--space-3); }
  }
</style>
