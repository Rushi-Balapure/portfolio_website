---
interface Props { project: string; }
const { project } = Astro.props;
---

<div class:list={['project-visual', `visual-${project}`]} aria-hidden={project === 'insidia-labs' ? undefined : 'true'}>
  {project === 'insidia-labs' ? (
    <figure class="argus-visual">
      <picture>
        <source srcset="/projects/argus-live-target.webp" type="image/webp" />
        <img src="/projects/argus-live-target.png" width="1280" height="720" loading="lazy" decoding="async" alt="Concept diagram: a running app or API flows into Argus, the free open-source dynamic scanner that drives nuclei, katana and httpx, and out into one report, with AI-app checks mapped to the OWASP LLM Top 10." />
      </picture>
      <figcaption>Illustrative concept — not a product screenshot</figcaption>
    </figure>
  ) : project === 'arise' ? (
    <div class="arise-visual"><div class="mini-bar"><i></i><i></i><i></i><span>~/experiments</span></div><div class="arise-code"><span class="code-muted">$</span> arise --style matrix<br/><span class="matrix">01 10 01 11 00 10 01<br/>10 01 <b>A R I S E</b> 10<br/>00 11 10 01 11 00 10</span><br/><span class="code-muted">(.venv)</span> <span class="code-green">ready to build</span> <span class="code-cursor">▌</span></div></div>
  ) : (
    <div class="analysis-visual"><div class="analysis-label"><span></span> TWO SIGNALS. ONE INVESTIGATION.</div><div class="analysis-sources"><div><span class="source-icon">&lt;/&gt;</span><strong>Source code</strong><small>Static analysis</small></div><span class="source-plus">+</span><div><span class="source-icon">⌁</span><strong>Network traffic</strong><small>Behavioral analysis</small></div></div><div class="signal-line"></div><span class="analysis-output">Vulnerability analysis ↗</span></div>
  )}
</div>

<style>
  .project-visual { display: grid; place-items: center; min-height: 16rem; padding: clamp(1rem, 3vw, 2.5rem); overflow: hidden; background: var(--visual-bg); border-bottom: 1px solid var(--line); }
  .visual-insidia-labs { padding: 0; }
  .argus-visual { display: flex; flex-direction: column; width: 100%; height: 100%; margin: 0; }
  .argus-visual picture { display: flex; flex: 1 1 auto; min-height: 0; }
  .argus-visual img { width: 100%; height: auto; aspect-ratio: 16 / 9; max-height: 100%; object-fit: contain; }
  .argus-visual figcaption { padding: 0.35rem 0.75rem 0.55rem; color: var(--muted); font: 0.7rem/1.3 var(--font-mono); letter-spacing: 0.04em; text-align: center; }
  .arise-visual { width: 100%; max-width: 25rem; overflow: hidden; background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 15px 30px #0002; }
  .mini-bar { display: flex; align-items: center; gap: 4px; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--line); }
  .mini-bar i { width: 5px; height: 5px; border-radius: 50%; background: var(--muted); }
  .mini-bar span { margin-left: auto; color: var(--muted); font: 0.5rem var(--font-mono); }
  .arise-code { padding: 1.2rem 1.5rem; font: 0.65rem/1.8 var(--font-mono); }
  .code-muted { color: var(--muted); }
  .matrix { display: block; padding-top: 0.8rem; color: color-mix(in srgb, var(--accent) 70%, var(--ink)); letter-spacing: 0.15em; text-align: center; }
  .matrix b, .code-green, .code-cursor { color: var(--link); }
  .analysis-visual { display: grid; justify-items: center; width: 100%; max-width: 28rem; }
  .analysis-label { display: flex; align-items: center; gap: 0.5rem; color: var(--muted); font: 0.5rem var(--font-mono); letter-spacing: 0.04em; }
  .analysis-label > span { width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .analysis-sources { display: flex; align-items: center; gap: 2rem; margin-top: 1.5rem; text-align: center; }
  .analysis-sources strong, .analysis-sources small { display: block; }
  .source-icon { display: grid; place-items: center; width: 44px; height: 44px; margin: 0 auto 0.6rem; border: 1px solid var(--line); background: var(--raised); border-radius: 10px; color: var(--accent); font: 1.1rem var(--font-mono); }
  .analysis-sources strong { font-size: 0.75rem; font-weight: 500; }
  .analysis-sources small { color: var(--muted); font-size: 0.6rem; }
  .source-plus { color: var(--muted); }
  .signal-line { width: 1px; height: 1.2rem; margin: 0.5rem 0; background: var(--line); }
  .analysis-output { color: var(--accent); font: 0.6rem var(--font-mono); }
  @media (max-width: 480px) {
    .project-visual { min-height: 15rem; }
  }
</style>
