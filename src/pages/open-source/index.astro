---
import { getCollection } from "astro:content";
import EntryCard from "../../components/EntryCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("openSource"))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) =>
  date.toLocaleDateString("en", { month: "short", year: "numeric" });
---

<BaseLayout title="Open Source" description="Open-source projects and contributions made in public.">
  <header class="shell archive-hero" data-reveal>
    <p class="eyebrow">Built in public</p>
    <h1 class="page-title">Open source</h1>
  </header>
  <section class="shell section" aria-labelledby="open-source-list">
    <h2 id="open-source-list" class="visually-hidden">Open-source contribution list</h2>
    <div class="grid">
      {entries.map(({ id, data }) => (
        <EntryCard
          href={`/open-source/${id}/`}
          eyebrow={`${data.organization ? `${data.organization} · ` : ""}${formatDate(data.date)}`}
          title={data.title}
          summary={data.contributionSummary ?? data.summary}
          tags={data.tags}
        />
      ))}
      {entries.length === 0 && <p class="empty-state">No open-source entries are published yet. Draft placeholders remain private until they contain verified work.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
