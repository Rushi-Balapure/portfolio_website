---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GitHubActivity from '../components/GitHubActivity.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content: HomeContent } = await render(home);
const profile = home.data;

const newest = <T extends { data: { date: Date; draft: boolean; featured: boolean } }>(entries: T[]) =>
  entries
    .filter(({ data }) => !data.draft)
    .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.getTime() - a.data.date.getTime());

const experience = (await getCollection('experience'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime())
  .slice(0, 3);
const projects = (await getCollection('projects'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.priority - a.data.priority || Number(b.data.featured) - Number(a.data.featured) || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const openSource = newest(await getCollection('openSource')).slice(0, 2);
const publications = newest(await getCollection('publications')).slice(0, 2);
const community = newest(await getCollection('community')).slice(0, 2);
const education = (await getCollection('education'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime())
  .slice(0, 2);

const yearRange = (start: Date, end?: Date) => `${start.getFullYear()}–${end?.getFullYear() ?? 'Now'}`;
---

<BaseLayout description={profile.summary}>
  <section class="hero shell">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow">{profile.eyebrow ?? profile.role ?? 'Portfolio'}</p>
      <h1 class="display">{profile.name}</h1>
      <div class="hero-prose"><HomeContent /></div>
      <div class="hero-actions">
        <a class="button" href="/projects/">Explore the work</a>
        <a class="button button--quiet" href="/resume.pdf" target="_blank" rel="noreferrer">Resume</a>
      </div>
      {profile.availability && (
        <p class="availability">
          <span aria-hidden="true"></span>
          {profile.availability}
        </p>
      )}
    </div>
    <div class="hero-portrait" data-reveal>
      <div class="portrait">
        {profile.cover
          ? <Image src={profile.cover} alt={`Portrait of ${profile.name}`} widths={[480, 720]} sizes="(max-width: 900px) 70vw, 28vw" loading="eager" fetchpriority="high" />
          : <span>{profile.name?.slice(0, 1) ?? 'R'}</span>}
      </div>
    </div>
  </section>

  <section class="skills-strip shell" aria-labelledby="skills-title" data-reveal>
    <div class="skills-copy">
      <h2 id="skills-title">Tech I use</h2>
      <p>The stack behind the products I ship.</p>
    </div>
    <dl class="skills-panel">
      <div><dt>Languages</dt><dd>Python, Ruby, SQL</dd></div>
      <div><dt>Frameworks</dt><dd>FastAPI, PyTorch, Scikit-learn, Hugging Face Transformers, LangChain</dd></div>
      <div><dt>Databases</dt><dd>Postgres, MySQL, Pinecone, Milvus</dd></div>
    </dl>
  </section>

  <section class="section shell" id="experience">
    <SectionHeading eyebrow="Experience" title="Roles with shipped products." href="/experience/" linkLabel="Full experience" />
    <div class="grouped-list">
      {experience.map(({ data }) => (
        <article class="grouped-row" data-reveal>
          <div>
            <p class="row-meta">{data.organization}</p>
            <h3>{data.role}</h3>
            <p class="row-copy">{data.summary}</p>
          </div>
          <p class="row-aside">{yearRange(data.startDate, data.endDate)}{data.location && ` · ${data.location}`}</p>
        </article>
      ))}
      {experience.length === 0 && <p class="empty-state">Experience entries are ready for your Markdown content.</p>}
    </div>
  </section>

  <section class="section shell">
    <SectionHeading eyebrow="Projects" title="Built to be used." href="/projects/" />
    <div class="grid">
      {projects.map(({ id, data }, index) => <EntryCard href={`/projects/${id}/`} eyebrow={data.status?.replace('-', ' ') ?? 'Project'} title={data.title} summary={data.summary} tags={data.stack ?? data.tags} large={index === 0} />)}
      {projects.length === 0 && <p class="empty-state">Projects will appear here as soon as their draft flag is removed.</p>}
    </div>
  </section>

  <section class="section shell">
    <SectionHeading eyebrow="Open source" title="Work that stays public." href="/open-source/" />
    <GitHubActivity username={profile.githubUsername} profileUrl={profile.githubUrl} />
    <div class="grid contribution-grid">
      {openSource.map(({ id, data }) => <EntryCard href={`/open-source/${id}/`} eyebrow={data.organization ?? 'Open source'} title={data.title} summary={data.summary} tags={data.tags} />)}
    </div>
  </section>

  <section class="section shell">
    <SectionHeading eyebrow="Research" title="Questions worth pursuing." href="/publications/" linkLabel="All publications" />
    <div class="grid">
      {publications.map(({ id, data }) => <EntryCard href={`/publications/${id}/`} eyebrow={data.venue ?? 'Publication'} title={data.title} summary={data.summary} tags={data.tags} />)}
      {publications.length === 0 && <p class="empty-state">Published papers will appear here after their Markdown entries are completed.</p>}
    </div>
  </section>

  <section class="section shell">
    <SectionHeading eyebrow="Community" title="Knowledge grows when shared." href="/community/" />
    <div class="grid">
      {community.map(({ id, data }) => <EntryCard href={`/community/${id}/`} eyebrow={data.eventOrOrganization ?? 'Community'} title={data.title} summary={data.summary} tags={data.tags} />)}
      {community.length === 0 && <p class="empty-state">Community work and speaking sessions are ready for your Markdown entries.</p>}
    </div>
  </section>

  <section class="section shell">
    <SectionHeading eyebrow="Education" title="Where the foundation was built." href="/education/" linkLabel="Education details" />
    <div class="grouped-list">
      {education.map(({ data }) => (
        <article class="grouped-row" data-reveal>
          <div>
            <p class="row-meta">{data.institution}</p>
            <h3>{data.title}</h3>
          </div>
          <p class="row-aside">{yearRange(data.startDate, data.endDate)}{data.cgpa && ` · CGPA ${data.cgpa}`}</p>
        </article>
      ))}
      {education.length === 0 && <p class="empty-state">Education details are ready for your Markdown content.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    min-height: calc(100svh - 6.5rem);
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4rem);
  }

  .hero-prose {
    max-width: 36rem;
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    letter-spacing: -0.012em;
    line-height: 1.45;
  }

  .hero-prose :global(p) { margin: 0.45rem 0; }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .availability {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .availability span {
    width: 0.5rem;
    height: 0.5rem;
    background: #30d158;
    border-radius: 50%;
    box-shadow: 0 0 0 4px color-mix(in srgb, #30d158 18%, transparent);
  }

  .hero-portrait {
    justify-self: end;
    width: min(100%, 22rem);
  }

  .portrait {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    display: grid;
    place-items: center;
    color: var(--button-text);
    background: var(--elevated);
    border: 1px solid var(--profile-border);
    border-radius: calc(var(--radius) + 0.35rem);
    box-shadow: var(--material-shadow);
  }

  .portrait span {
    font-size: clamp(4rem, 10vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 44%;
  }

  .skills-strip {
    display: grid;
    grid-template-columns: 0.42fr 1.58fr;
    gap: 1.5rem;
    align-items: start;
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .skills-copy h2 {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 590;
    color: var(--muted);
  }

  .skills-copy p {
    margin: 0.4rem 0 0;
    color: var(--ink);
    font-size: 1.05rem;
    letter-spacing: -0.015em;
  }

  .skills-panel {
    margin: 0;
    overflow: hidden;
    background: var(--elevated);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 0.15rem);
    box-shadow: var(--material-shadow);
  }

  .skills-panel div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--line);
  }

  .skills-panel div:last-child { border-bottom: 0; }
  .skills-panel dt {
    margin: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 590;
  }
  .skills-panel dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .grouped-list {
    overflow: hidden;
    background: var(--elevated);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 0.15rem);
    box-shadow: var(--material-shadow);
  }

  .grouped-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1.25rem;
    padding: 1.25rem 1.3rem;
    border-bottom: 1px solid var(--line);
  }

  .grouped-row:last-child { border-bottom: 0; }

  .row-meta,
  .row-aside {
    margin: 0;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 510;
    font-variant-numeric: tabular-nums;
  }

  .grouped-row h3 {
    margin: 0.2rem 0 0;
    font-size: clamp(1.25rem, 2.4vw, 1.65rem);
    font-weight: 590;
    letter-spacing: -0.025em;
  }

  .row-copy {
    max-width: 42rem;
    margin: 0.45rem 0 0;
    color: var(--muted);
    text-wrap: pretty;
  }

  .row-aside {
    text-align: right;
    white-space: nowrap;
  }

  .contribution-grid { margin-top: 0.85rem; }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .hero-portrait {
      order: -1;
      width: min(100%, 18rem);
      justify-self: start;
    }

    .skills-strip,
    .grouped-row { grid-template-columns: 1fr; }

    .row-aside {
      text-align: left;
      white-space: normal;
    }
  }

  @media (max-width: 560px) {
    .skills-panel div { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
