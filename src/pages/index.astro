---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import GitHubActivity from '../components/GitHubActivity.astro';
import LaptopShowcase from '../components/LaptopShowcase.astro';
import TechStack from '../components/TechStack.astro';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content: HomeContent } = await render(home);
const profile = home.data;
const [firstName, ...lastName] = (profile.name ?? 'Rushi Balapure').split(' ');
const newest = <T extends { data: { date: Date; draft: boolean; featured: boolean } }>(entries: T[]) => entries
  .filter(({ data }) => !data.draft)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.getTime() - a.data.date.getTime());
const experience = (await getCollection('experience')).filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()).slice(0, 3);
const projects = (await getCollection('projects')).filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.priority - a.data.priority || b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const openSource = newest(await getCollection('openSource')).slice(0, 2);
const publications = newest(await getCollection('publications')).slice(0, 2);
const community = newest(await getCollection('community')).slice(0, 2);
const education = (await getCollection('education')).filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()).slice(0, 2);
const yearRange = (start: Date, end?: Date) => `${start.getFullYear()}—${end?.getFullYear() ?? 'Now'}`;
---

<BaseLayout description={profile.summary}>
  <section class="hero shell" aria-labelledby="intro-title">
    <div class="hero-copy" data-reveal>
      <p class="hero-kicker"><span aria-hidden="true">✳</span> {profile.role} <span class="kicker-divider">/</span> {profile.location}</p>
      <h1 class="display" id="intro-title">{firstName}<br/>{lastName.join(' ')}<span class="name-period">.</span></h1>
      <p class="hero-tagline">Curiosity in.<br/><span>Something useful out.</span></p>
      <div class="hero-prose"><HomeContent /></div>
      <div class="hero-actions">
        <a class="button" href="#selected-work">Explore my work <span aria-hidden="true">↗</span></a>
        <a class="button button--quiet" href="/resume.pdf" target="_blank" rel="noreferrer">Resume <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-socials" aria-label="Find me online">
        {profile.githubUrl && <a href={profile.githubUrl} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>}
        {profile.linkedinUrl && <a href={profile.linkedinUrl} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>}
        {profile.email && <a href={`mailto:${profile.email}`}>Say hello <span aria-hidden="true">↗</span></a>}
      </div>
      {profile.availability && <p class="availability">{profile.availability}</p>}
    </div>
    <LaptopShowcase />
    <div class="hero-bottom" aria-hidden="true"><span>PERSONAL PORTFOLIO / {new Date().getFullYear()}</span><span>A FEW THINGS I'VE PUT MY MIND TO ↓</span></div>
  </section>

  <TechStack />

  <section class="section shell" id="selected-work" aria-label="Selected projects">
    <SectionHeading eyebrow="01 / Selected work" title="Ideas made tangible." href="/projects/" linkLabel="All projects" />
    <div class="grid">
      {projects.map(({ id, data }, index) => <EntryCard href={`/projects/${id}/`} eyebrow={`${String(index + 1).padStart(2, '0')} / ${data.status?.replace('-', ' ') ?? 'Project'}`} title={data.title} summary={data.summary} tags={data.stack ?? data.tags} large={index === 0} project={id} />)}
    </div>
  </section>

  <section class="section shell" id="experience">
    <SectionHeading eyebrow="02 / The day job" title="Building in the real world." href="/experience/" linkLabel="Full experience" />
    <div class="experience-list">
      {experience.map(({ data }) => (
        <article class="experience-card" data-reveal>
          <div class="experience-timeline"><span class="timeline-dot" aria-hidden="true"></span><span>{yearRange(data.startDate, data.endDate)}</span></div>
          <div class="experience-body"><header><div><p class="eyebrow">{data.organization}</p><h3>{data.role}</h3></div><span class="location">{data.location}</span></header>
            <p class="experience-summary">{data.summary}</p>
            {data.highlights.length > 0 && <ul class="experience-highlights">{data.highlights.map((highlight) => <li>{highlight}</li>)}</ul>}
            <ul class="pill-list">{data.tags.map((tag) => <li class="pill">{tag}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell" aria-label="Open source">
    <SectionHeading eyebrow="03 / Out in the open" title="Better when shared." href="/open-source/" linkLabel="Open source" />
    <GitHubActivity username={profile.githubUsername} profileUrl={profile.githubUrl} />
    <div class="grid contribution-grid">{openSource.map(({ id, data }) => <EntryCard href={`/open-source/${id}/`} eyebrow={data.organization ?? 'Open source'} title={data.title} summary={data.summary} tags={data.tags} />)}</div>
  </section>

  <section class="section shell" aria-label="Research">
    <SectionHeading eyebrow="04 / Research notes" title="Questions worth asking." href="/publications/" linkLabel="All publications" />
    <div class="grid">{publications.map(({ id, data }) => <EntryCard href={`/publications/${id}/`} eyebrow={data.venue ?? 'Publication'} title={data.title} summary={data.summary} tags={data.tags} />)}</div>
  </section>

  <section class="section shell" aria-label="Community and speaking">
    <SectionHeading eyebrow="05 / Beyond the keyboard" title="Learning goes both ways." href="/community/" linkLabel="Community & talks" />
    <div class="grid">{community.map(({ id, data }) => <EntryCard href={`/community/${id}/`} eyebrow={data.eventOrOrganization ?? 'Community'} title={data.title} summary={data.summary} tags={data.tags} />)}</div>
  </section>

  <section class="section shell" aria-label="Education">
    <SectionHeading eyebrow="06 / The foundation" title="Where it started." href="/education/" linkLabel="Education" />
    {education.map(({ data }) => <article class="education-row" data-reveal><div class="education-icon" aria-hidden="true">↗</div><div><p>{data.institution}</p><h3>{data.title}</h3></div><span>{yearRange(data.startDate, data.endDate)}{data.cgpa && <small>CGPA {data.cgpa}</small>}</span></article>)}
  </section>
</BaseLayout>

<style>
  .hero { position: relative; display: grid; grid-template-columns: 0.95fr 1.05fr; align-items: center; gap: 2rem; padding-block: clamp(3.5rem, 6vw, 6rem) 5rem; }
  .hero-copy { position: relative; z-index: 1; min-width: 0; }
  .hero-kicker { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1.8rem; color: var(--muted); font-size: 0.63rem; }
  .hero-kicker > span:first-child { color: var(--accent); font-size: 1rem; }
  .kicker-divider { opacity: 0.45; }
  .name-period { color: var(--accent); }
  .hero-tagline { margin: 1.5rem 0 0; font-size: clamp(1.15rem, 2vw, 1.45rem); line-height: 1.4; letter-spacing: -0.03em; }
  .hero-tagline > span { color: var(--muted); }
  .hero-prose { max-width: 24rem; margin-top: 1rem; color: var(--muted); font-size: 0.85rem; line-height: 1.8; }
  .hero-prose :global(p) { margin: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.65rem; margin-top: 1.75rem; }
  .hero-socials { display: flex; gap: 1.3rem; margin-top: 1.2rem; }
  .hero-socials a { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 36px; color: var(--muted); font-size: 0.68rem; text-decoration: none; }
  .hero-socials a:hover { color: var(--accent); }
  .hero-socials a span { font-size: 0.65rem; }
  .availability { font-size: 0.75rem; color: var(--green); }
  .hero-bottom { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; color: var(--muted); font: 0.53rem var(--font-mono); letter-spacing: 0.09em; }
  #selected-work { scroll-margin-top: calc(var(--header-height) + 1rem); }
  .experience-card { display: grid; grid-template-columns: 10rem 1fr; gap: 2rem; padding-block: 1rem; }
  .experience-timeline { display: flex; align-items: start; gap: 0.7rem; padding-top: 0.2rem; color: var(--muted); font: 0.65rem var(--font-mono); }
  .timeline-dot { width: 7px; height: 7px; flex-shrink: 0; margin-top: 3px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 0 5px var(--accent-glow); }
  .experience-body { border-left: 1px solid var(--line); padding-left: 2rem; }
  .experience-body header { display: flex; justify-content: space-between; gap: 1rem; align-items: start; }
  .experience-body .eyebrow { margin-bottom: 0.55rem; }
  .experience-body h3 { margin: 0; font-size: clamp(1.3rem, 2.5vw, 1.8rem); font-weight: 500; letter-spacing: -0.035em; }
  .location { color: var(--muted); font-size: 0.65rem; }
  .experience-summary { max-width: 40rem; color: var(--muted); font-size: 0.85rem; margin-block: 1.3rem; }
  .experience-highlights { display: grid; gap: 0.7rem; padding-left: 1rem; color: var(--prose); font-size: 0.8rem; }
  .experience-highlights li::marker { color: var(--accent); }
  .contribution-grid { margin-top: 1rem; }
  .education-row { display: flex; align-items: center; gap: 1.5rem; padding-block: 1rem; }
  .education-icon { display: grid; place-items: center; flex-shrink: 0; width: 54px; height: 54px; border: 1px solid var(--line); border-radius: 12px; color: var(--accent); background: var(--surface); font-size: 1.3rem; }
  .education-row p { margin: 0 0 0.4rem; color: var(--muted); font-size: 0.75rem; }
  .education-row h3 { margin: 0; font-size: 1.05rem; font-weight: 500; letter-spacing: -0.02em; }
  .education-row > span { margin-left: auto; flex-shrink: 0; text-align: right; font: 0.65rem/1.8 var(--font-mono); color: var(--muted); }
  .education-row small { display: block; font: inherit; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 0; padding-top: 3rem; padding-bottom: 2rem; }
    .hero-copy { max-width: 35rem; }
    .hero-prose { max-width: 30rem; }
    .hero-bottom { margin-top: 3rem; }
    .experience-card { grid-template-columns: 7rem 1fr; gap: 1rem; }
  }
  @media (max-width: 560px) {
    .hero-kicker { font-size: 0.6rem; }
    .hero-bottom { font-size: 0.45rem; }
    .hero-bottom > span:last-child { max-width: 20ch; text-align: right; }
    .experience-card { grid-template-columns: 1fr; gap: 1.5rem; }
    .experience-body { padding-left: 1.2rem; }
    .experience-body header { flex-direction: column; gap: 0.6rem; }
    .education-row { flex-wrap: wrap; gap: 1rem; }
    .education-row > div:nth-child(2) { flex: 1; }
    .education-row > span { margin-left: 70px; text-align: left; }
  }
</style>
