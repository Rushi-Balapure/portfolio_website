---
import { getCollection } from "astro:content";
import EntryCard from "../../components/EntryCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blogs"))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Blogs" description="Technical articles, notes, and lessons from the work.">
  <header class="shell archive-hero" data-reveal>
    <p class="eyebrow">Writing archive</p>
    <h1 class="page-title">Blogs</h1>
  </header>
  <section class="shell section" aria-labelledby="blog-list">
    <h2 id="blog-list" class="visually-hidden">Blog post list</h2>
    <div class="grid">
      {posts.map(({ id, data }) => (
        <EntryCard
          href={`/blogs/${id}/`}
          title={data.title}
          summary={data.description ?? data.summary}
          date={data.date}
          tags={data.tags}
        />
      ))}
      {posts.length === 0 && <p class="empty-state">No articles are published yet.</p>}
    </div>
  </section>
</BaseLayout>

