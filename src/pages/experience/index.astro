---
import { getCollection, render } from "astro:content";
import SectionHeading from "../../components/SectionHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("experience"))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
const experience = await Promise.all(
  entries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);

const year = (date: Date) => date.getFullYear();
const dateRange = (startDate: Date, endDate?: Date) =>
  `${year(startDate)}–${endDate ? year(endDate) : "Present"}`;
---

<BaseLayout title="Experience" description="Professional roles, responsibilities, and outcomes over time.">
  <header class="shell archive-hero" data-reveal>
    <p class="eyebrow">Career timeline</p>
    <h1 class="page-title">Experience</h1>
  </header>
  <section class="shell section" aria-labelledby="experience-list">
    <SectionHeading
      eyebrow="Professional work"
      title="Where I’ve contributed"
    />
    <h2 id="experience-list" class="visually-hidden">Experience timeline</h2>
    <div class="timeline">
      {experience.map(({ data, Content }) => (
        <article class="role" data-reveal>
          <aside>
            <p>{dateRange(data.startDate, data.endDate)}</p>
            <span>{data.location}</span>
          </aside>
          <div class="role-content">
            <p class="organization">
              {data.organizationUrl ? <a href={data.organizationUrl} target="_blank" rel="noreferrer">{data.organization} ↗</a> : data.organization}
            </p>
            <h3>{data.role}</h3>
            <p class="summary">{data.summary}</p>
            <ul class="pill-list" aria-label="Skills">{data.tags.map((tag) => <li class="pill">{tag}</li>)}</ul>
            <div class="prose details"><Content /></div>
          </div>
        </article>
      ))}
      {experience.length === 0 && <p class="empty-state">No experience entries are published yet. The current placeholder is a draft and is intentionally hidden.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .timeline { border-top: 1px solid var(--line); }
  .role { display: grid; grid-template-columns: minmax(10rem, 0.32fr) 1fr; gap: clamp(2rem, 7vw, 7rem); padding-block: clamp(3rem, 7vw, 6rem); border-bottom: 1px solid var(--line); }
  .role aside p { margin: 0; font-size: 0.84rem; font-weight: 750; }
  .role aside span { color: var(--muted); font-size: 0.8rem; }
  .organization { margin: 0 0 0.75rem; color: var(--accent); font-size: 0.8rem; font-weight: 750; letter-spacing: 0.08em; text-transform: uppercase; }
  .organization a { color: inherit; }
  .role h3 { max-width: 18ch; margin: 0; font-size: clamp(2rem, 4.5vw, 4rem); letter-spacing: -0.055em; line-height: 1; }
  .summary { max-width: 42rem; margin: 1.25rem 0 0; color: var(--muted); font-size: 1.08rem; }
  .details { padding-top: 2.5rem; margin-top: 2.5rem; border-top: 1px solid var(--line); }
  .details :global(h2:first-child) { margin-top: 0; }
  .details :global(h2) { font-size: clamp(1.4rem, 3vw, 2rem); }
  .details :global(li) { margin-bottom: 0.75rem; }
  @media (max-width: 700px) {
    .role { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
