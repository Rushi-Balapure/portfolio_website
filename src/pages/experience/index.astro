---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const entries = (await getCollection("experience"))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
const experience = await Promise.all(
  entries.map(async (entry) => ({ ...entry, Content: (await render(entry)).Content })),
);

const year = (date: Date) => date.getFullYear();
const dateRange = (startDate: Date, endDate?: Date) =>
  `${year(startDate)}–${endDate ? year(endDate) : "Present"}`;
---

<BaseLayout title="Experience" description="Professional roles, responsibilities, and outcomes over time.">
  <header class="shell archive-hero" data-reveal>
    <p class="eyebrow">Career timeline</p>
    <h1 class="page-title">Experience</h1>
  </header>
  <section class="shell section" aria-labelledby="experience-list">
    <h2 id="experience-list" class="visually-hidden">Experience timeline</h2>
    <div class="timeline">
      {experience.map(({ data, Content }) => (
        <article class="role" data-reveal>
          <aside>
            <p>{dateRange(data.startDate, data.endDate)}</p>
            <span>{data.location}</span>
          </aside>
          <div class="role-content">
            <p class="organization">
              {data.organizationUrl ? <a href={data.organizationUrl} target="_blank" rel="noreferrer">{data.organization} ↗</a> : data.organization}
            </p>
            <h3>{data.role}</h3>
            <p class="summary">{data.summary}</p>
            <ul class="pill-list" aria-label="Skills">{data.tags.map((tag) => <li class="pill">{tag}</li>)}</ul>
            <div class="prose details"><Content /></div>
          </div>
        </article>
      ))}
      {experience.length === 0 && <p class="empty-state">No experience entries are published yet. The current placeholder is a draft and is intentionally hidden.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .timeline {
    display: grid;
    gap: 0.85rem;
  }

  .role {
    display: grid;
    grid-template-columns: minmax(9rem, 0.28fr) 1fr;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    padding: clamp(1.25rem, 3vw, 1.85rem);
    background: var(--elevated);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 0.15rem);
    box-shadow: var(--material-shadow);
  }

  .role aside p {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 590;
    font-variant-numeric: tabular-nums;
  }

  .role aside span {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .organization {
    margin: 0 0 0.45rem;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 590;
  }

  .organization a { color: inherit; text-decoration: none; }
  .organization a:hover { color: var(--accent); }

  .role h3 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .summary {
    max-width: 42rem;
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 1.05rem;
    text-wrap: pretty;
  }

  .details {
    padding-top: 1.5rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .details :global(h2:first-child) { margin-top: 0; }
  .details :global(h2) { font-size: clamp(1.2rem, 2.4vw, 1.55rem); }
  .details :global(li) { margin-bottom: 0.65rem; }

  @media (max-width: 700px) {
    .role { grid-template-columns: 1fr; }
  }
</style>
