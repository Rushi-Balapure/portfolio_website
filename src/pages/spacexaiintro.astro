---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SpaceX AI Intro" description="SpaceX AI introduction video." noindex>
  <section class="shell video-page" aria-labelledby="video-title">
    <p class="eyebrow">Video</p>
    <h1 id="video-title" class="page-title">SpaceX AI Intro</h1>
    <video controls playsinline preload="metadata" aria-label="SpaceX AI introduction video">
      <source src="/spacexaiintro/intro.mp4" type="video/mp4" />
      Your browser does not support video playback. <a href="/spacexaiintro/intro.mp4">Download the video</a>.
    </video>
  </section>
</BaseLayout>

<style>
  .video-page {
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  video {
    display: block;
    width: 100%;
    max-height: 75vh;
    margin-top: 2.5rem;
    background: #000;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
</style>
